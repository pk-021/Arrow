{
  "private": true,
  "scripts": {
    "test:popup": "node --test tests/popup-shell.test.js",
    "check:popup": "node --check js/core/config.js && node --check js/core/state.js && node --check js/popup.js && node --check js/background.js && node --test tests/*.test.js",
    "build:dev": "powershell -ExecutionPolicy Bypass -File scripts/build-extension.ps1 -Target development",
    "build:web-store": "powershell -ExecutionPolicy Bypass -File scripts/build-extension.ps1 -Target web-store",
    "build:web-store-draft": "powershell -ExecutionPolicy Bypass -File scripts/build-extension.ps1 -Target web-store-draft",
    "set:store-key": "powershell -ExecutionPolicy Bypass -File scripts/set-extension-key.ps1"
  }
}
